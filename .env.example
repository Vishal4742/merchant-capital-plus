# Copy the names into .env and fill in the values. Never commit .env (CON-7). Never print a value.
# Whitechain Sepolia (1874)
WHITECHAIN_RPC_URL=https://rpc.ankr.com/whitechain_testnet
DEPLOYER_PRIVATE_KEY=     # deployer + team wallet + compliance admin; funds demo wallets (CON-8)
RELAYER_PRIVATE_KEY=      # relayer hot wallet, apps/relayer only, keep <= 0.5 WBT
# Arkiv Rabdi testnet (7794095)
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_PRIVATE_KEY=        # Arkiv writer, apps/web server only
ARKIV_ACCESS_KEY=         # hub.arkiv.network/access-keys (goes in the RPC URL path; origin-restricted, not a secret); keyless endpoint times out
# Neon Postgres (apps/web + apps/relayer, Phase 2)
DATABASE_URL=
# Shared memory (tools/supermemory.sh, tools/claude.sh)
SUPERMEMORY_API_KEY=
SUPERMEMORY_CC_API_KEY=
OPENAI_API_KEY=           # DeepSeek, OpenAI-compatible
OPENAI_BASE_URL=
OPENAI_MODEL=
